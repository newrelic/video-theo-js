{
  "name": "@newrelic/video-theo",
  "version": "1.0.0",
  "description": "New relic tracker for theo player",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./browser": {
      "import": "./dist/esm/browser/index.js",
      "require": "./dist/cjs/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "build:unminified": "webpack --config webpack.config.dev.js",
    "watch": "webpack  --progress --color --watch",
    "watch:dev": "webpack --progress --color --watch --mode development",
    "watch:unminified": "webpack --config webpack.config.dev.js --progress --color --watch",
    "prezip": "npm run build",
    "zip": "zip -P newrelic -x '*.DS_Store' -r theo.zip dist samples README.md CHANGELOG.md EULA.md",
    "test": "jest --coverage",
    "clean": "rm -rf dist *.zip",
    "third-party-updates": "oss third-party manifest --includeOptDeps && oss third-party notices --includeOptDeps && git add THIRD_PARTY_NOTICES.md third_party_manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/newrelic/video-theo-js"
  },
  "author": "Peter Addo",
  "license": "New Relic",
  "dependencies": {
    "@newrelic/video-core": "^5.1.0",
    "theoplayer": "^10.5.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "terser-webpack-plugin": "^5.3.10",
    "@semantic-release/commit-analyzer": "^12.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.3",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^13.0.0",
    "semantic-release": "^25.0.8",
    "@babel/cli": "^7.25.6",
    "@babel/core": "^7.25.2",
    "@babel/node": "^7.25.0",
    "@babel/plugin-transform-modules-commonjs": "^7.24.8",
    "@babel/preset-env": "^7.25.4",
    "@babel/register": "^7.24.6",
    "@newrelic/newrelic-oss-cli": "^0.1.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^4.9.2",
    "webpack-obfuscator": "^3.5.1"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "src",
    "browser.js",
    "CHANGELOG.md",
    "README.md",
    "!test",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
